# Copy to .env for local dev. On Vercel, add the same keys under
# Project → Settings → Environment Variables.

# Secret used to sign session tokens (HMAC-SHA256). Required in production.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Comma-separated list of emails allowed into /admin to moderate
# community-submitted parking spots, reports and contact messages. Must match
# a registered account's email exactly (case-insensitive).
ADMIN_EMAILS=you@example.com

# Supabase (Dashboard → Project Settings → API). The service-role key is
# server-only — never expose it with a NEXT_PUBLIC_ prefix.
# SUPABASE_URL is just the Project URL — nothing after ".supabase.co".
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Email (password-reset links + "something needs review" notices to admins).
# Optional in local dev — without it, reset links are shown on screen and
# admins aren't notified. Pick ONE of the two free options:
#
# Option A — Gmail (no domain needed). Turn on 2-Step Verification, create an
# app password at https://myaccount.google.com/apppasswords and paste it here.
SMTP_USER=
SMTP_PASS=
# Only for non-Gmail SMTP providers:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
#
# Option B — Resend (https://resend.com). EMAIL_FROM must use a domain
# verified in Resend.
RESEND_API_KEY=
# EMAIL_FROM="Paradahan <no-reply@yourdomain.com>"

# Public site URL used in emailed links, e.g. https://paradahan.vercel.app.
# Optional — defaults to the URL the request came in on.
APP_URL=
